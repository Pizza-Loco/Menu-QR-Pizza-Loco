e = html.escape
nav = "".join(f'<a href="#{i}">{e(t)}</a>' for i, t, *_ in S)
body = []
for i, t, sub, img, items in S:
    rows = "".join(
        f'<li><div class="row"><h3>{e(n)}</h3><span class="dots"></span><b>{p}&nbsp;€</b></div>'
        + (f'<p>{e(d)}</p>' if d else '') + '</li>'
        for n, p, d in items)
    pic = f'<img class="photo" src="img/{img}" alt="" loading="lazy">' if img else ''
    extra = ''
    if i == "especiales":
        extra = ('<div class="promo"><div><span class="r">Prueba nuestra</span>'
                 '<span class="g">Pizza Portafoglio</span><span class="big">…5&nbsp;€</span></div>'
                 '<img src="img/portafoglio.jpg" alt="Pizza Portafoglio" loading="lazy"></div>')
    body.append(f'<section id="{i}"><p class="kicker">{e(sub)}</p><h2>{e(t)}</h2>{pic}<ul>{rows}</ul>{extra}</section>')

page = f'''<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Carta · Pizza Loco</title>
<meta name="description" content="Carta de Pizza Loco: entrantes, pizzas napolitanas, pastas, burguers y postres.">
<meta name="theme-color" content="#0a8a45">
<style>
:root{{--g:#0a8a45;--r:#d8112d;--bg:#fffaf1;--ink:#231f1c;--mute:#6b625b;--line:#e6dccb}}
*{{box-sizing:border-box}}
body{{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}}
header{{background:#fff;text-align:center;padding:12px 16px 0;border-bottom:6px solid var(--g)}}
header img{{width:min(340px,80%);height:auto;display:block;margin:0 auto}}
header p{{margin:6px 0 12px;color:var(--mute);font-size:.95rem}}
nav{{position:sticky;top:0;z-index:5;display:flex;gap:8px;overflow-x:auto;padding:10px 12px;background:var(--g);scrollbar-width:none}}
nav a{{flex:none;color:#fff;text-decoration:none;font-weight:600;font-size:.9rem;padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.15)}}
nav a:active,nav a:hover{{background:#fff;color:var(--g)}}
main{{max-width:720px;margin:0 auto;padding:0 16px 32px}}
section{{padding-top:28px;scroll-margin-top:56px}}
.kicker{{margin:0;color:var(--r);font-weight:700;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}}
h2{{margin:2px 0 14px;font-size:1.9rem;color:var(--g);line-height:1.1;display:inline-block;border-bottom:4px solid var(--r);padding-bottom:4px}}
.photo{{width:100%;height:auto;border-radius:14px;display:block;margin:6px 0 16px}}
ul{{list-style:none;margin:0;padding:0}}
li{{padding:11px 0;border-bottom:1px dashed var(--line)}}
li:last-child{{border:0}}
.row{{display:flex;align-items:baseline;gap:8px}}
h3{{margin:0;font-size:1.02rem;color:var(--r);text-transform:uppercase;letter-spacing:.02em}}
.dots{{flex:1;border-bottom:2px dotted var(--line);transform:translateY(-4px);min-width:12px}}
.row b{{font-variant-numeric:tabular-nums;white-space:nowrap}}
li p{{margin:3px 0 0;color:var(--mute);font-size:.92rem}}
.promo{{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;padding:14px 16px;background:#fff;border:2px solid var(--g);border-radius:16px}}
.promo span{{display:block;font-weight:800;text-transform:uppercase;line-height:1.1}}
.promo .r{{color:var(--r);font-size:1.2rem}}.promo .g{{color:var(--g);font-size:1.2rem}}
.promo .big{{color:var(--r);font-size:2.6rem}}
.promo img{{width:38%;max-width:150px;border-radius:12px}}
footer{{text-align:center;padding:20px 16px 36px;color:var(--mute);font-size:.85rem;border-top:6px solid var(--g);background:#fff}}
footer a{{color:var(--g);font-weight:600}}
@media(min-width:640px){{h2{{font-size:2.3rem}}}}
</style>
</head>
<body>
<header><img src="img/hero.jpg" alt="Pizza Loco"><p>Pizza napolitana · Granada</p></header>
<nav>{nav}</nav>
<main>
{"".join(body)}
</main>
<footer><a href="carta.pdf">Descargar la carta en PDF</a></footer>
</body>
</html>
'''
open(sys.argv[1], "w", encoding="utf-8").write(page)
